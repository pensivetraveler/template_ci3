# 복사해서 .env.development / .env.production 으로 쓴다 (커밋하지 않음)
# ENCRYPTION_KEY: hex:$(openssl rand -hex 32)   JWT_KEY: $(openssl rand -base64 48)
SYSTEM_INSPECTION=false
ALLOWED_IPS=
CACHING_MENU=false

COMP_NAME=
COMP_NAME_KR=
COMP_URL=
APP_NAME=
APP_NAME_KR=
APP_ENV=
APP_KEY=
JWT_KEY=
APP_DEBUG=
APP_URL=
APP_GIT=

ENCRYPTION_KEY=
PASSWORD_DECRYPTABLE=FALSE

LOG_CHANNEL=
LOG_DEPRECATIONS_CHANNEL=
LOG_LEVEL=

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_PREFIX=tbl_
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_general_ci

BROADCAST_DRIVER=
CACHE_DRIVER=
FILESYSTEM_DRIVER=
QUEUE_CONNECTION=
SESSION_DRIVER=
SESSION_LIFETIME=

MEMCACHED_HOST=

REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_CLIENT=

MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
MAIL_BCC=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=

MIX_PUSHER_APP_KEY=
MIX_PUSHER_APP_CLUSTER=

NCLOUD_SMS_KEY=
NCLOUD_ACCESS_KEY=
NCLOUD_SECRET=
SMS_SEND_NUMBER=

KCP_SITE_CODE=
KCP_SITE_KEY=

IMPORT_CODE=
IMPORT_API_KEY=
IMPORT_API_SECRET=

NAVER_PAY_CHANNEL_NAME=
NAVER_PAY_CHANNEL_KEY=
NAVER_PAY_PG_ID=
NAVER_PAY_CLIENT_ID=
NAVER_PAY_SECRET=
NAVER_PAY_CHAIN_ID=

CHANNELTALK_KEY=
CHANNELTALK_SECRET=

IS_ADMIN=1
PYTHON_BIN_PATH=

# CORS: 기본은 같은 출처만 허용. 다른 출처에서 API 를 부를 때만 설정 (쉼표 구분, 예: https://a.example.com,https://b.example.com)
CORS_ALLOWED_ORIGINS=
# 모든 출처 허용 (권장하지 않음)
CORS_ALLOW_ANY=false

# 인증 토큰 유효 시간(초): 발급(로그인) 후 이 시간이 지나면 만료 → 다시 로그인(자동 로그인 쿠키가 있으면 새 토큰). 기본 43200(12시간), 0 이면 만료 없음
# 관리자 > 시스템 > 환경값 설정의 SYS_AUTH_TOKEN_LIFETIME 값이 있으면 그 값이 먼저 (docs/migrations/2026-10-28-sys-cfg-token-lifetime.sql)
TOKEN_LIFETIME=43200
