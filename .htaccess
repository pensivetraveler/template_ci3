<IfModule mod_setenvif.c>
    #Authorization 헤더를 PHP에 전달 (Apache는 기본으로 $_SERVER['HTTP_AUTHORIZATION']에 넣지 않음, REST API 키 검사에 필요)
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
<IfModule mod_php.c>
    #Session Auto Start Off
    php_flag session.auto_start off

    #Session timeout
    php_value session.cookie_lifetime 43200
    php_value session.gc_maxlifetime 43200
</IfModule>
<IfModule mod_php5.c>
    #Session Auto Start Off
    php_flag session.auto_start off

    #Session timeout
    php_value session.cookie_lifetime 43200
    php_value session.gc_maxlifetime 43200
</IfModule>
<IfModule mod_env.c>
    #Set Environment(development,testing,production)
    SetEnv CI_ENV development
</IfModule>
<IfModule mod_rewrite.c>
    #if mod_env module not enabled in server
    #Set Environment(development,testing,production)
    RewriteRule ^ - [E=CI_ENV:development]

    Options +FollowSymlinks -Indexes
    RewriteEngine On
    RewriteBase /
    DirectoryIndex index.php
    RewriteCond $1 !^(index\.php|images|robots\.txt|css|docs|js|system|public)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
    #<Files ~ "\.(env|env.development|env.production|json|config.js|md|gitignore|gitattributes|lock)$">
    <Files ~ "\.(env|env.development|env.production|config.js|md|gitignore|gitattributes|lock|bak)$">
        Order allow,deny
        Deny from all
    </Files>
</IfModule>